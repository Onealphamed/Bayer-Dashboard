# Copy to .env.local for `npm run dev`. On Vercel, set these under
# Project -> Settings -> Environment Variables instead. Generate strong values with:
#   node scripts/generate-secrets.mjs <login-id>

# --- required ---------------------------------------------------------------
PORTAL_USERNAME=admin
PORTAL_PASSWORD=change-me

# --- strongly recommended ---------------------------------------------------
SESSION_SECRET=
VAULT_KEY=

# --- optional ---------------------------------------------------------------
PORTAL_TITLE=Master Dashboard
SESSION_TTL_HOURS=12
# Extra users. role "admin" can add/edit/delete, "viewer" can only open and copy.
# PORTAL_USERS=[{"username":"teammate","password":"another-strong-password","role":"viewer"}]

# Initial dashboard list (JSON array). Read-only when no storage is connected;
# imported once into storage when Upstash Redis is connected.
DASHBOARDS=[{"name":"Example","url":"https://example.com","category":"Demo","username":"","password":"","notes":""}]

# Added automatically when you connect Upstash Redis in Vercel -> Storage:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
